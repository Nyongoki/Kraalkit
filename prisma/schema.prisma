generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TermStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum VetType {
  REGISTERED_VET
  CLINIC
  ANIMAL_HEALTH_WORKER
}

enum UserRole {
  FARMER
  VET
  CONTRIBUTOR
  ADMIN
}

model Language {
  id         Int           @id @default(autoincrement())
  code       String        @unique @db.VarChar(10)
  name       String
  nativeName String?
  isActive   Boolean       @default(true)
  terms      SymptomTerm[]
}

model Species {
  id       Int                   @id @default(autoincrement())
  slug     String                @unique
  name     String
  symptoms SymptomSpecies[]
  diseases DiseaseSpecies[]
  vets     VetSpecies[]
  reports  Report[]
  needs    NutrientRequirement[]
}

model Symptom {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  nameEn      String
  description String?          @db.Text
  terms       SymptomTerm[]
  species     SymptomSpecies[]
  diseases    DiseaseSymptom[]
  reports     ReportSymptom[]
}

model SymptomSpecies {
  symptomId Int
  speciesId Int
  symptom   Symptom @relation(fields: [symptomId], references: [id])
  species   Species @relation(fields: [speciesId], references: [id])

  @@id([symptomId, speciesId])
}

model SymptomTerm {
  id            Int        @id @default(autoincrement())
  symptomId     Int
  languageId    Int
  text          String     @db.VarChar(255)
  variant       String?
  status        TermStatus @default(PENDING)
  contributor   String?
  votes         Int        @default(0)
  confirmedById Int?
  confirmedAt   DateTime?
  createdAt     DateTime   @default(now())
  symptom       Symptom    @relation(fields: [symptomId], references: [id])
  language      Language   @relation(fields: [languageId], references: [id])
  confirmedBy   VetUser?   @relation(fields: [confirmedById], references: [id])

  @@unique([symptomId, languageId, text])
  @@index([languageId, status])
  @@fulltext([text])
}

model Disease {
  id               Int              @id @default(autoincrement())
  slug             String           @unique
  name             String
  nameSw           String?
  urgency          Urgency
  notifiable       Boolean          @default(false)
  firstAid         String?          @db.Text
  firstAidSw       String?          @db.Text
  fallbackAdvice   String?          @db.Text
  fallbackAdviceSw String?          @db.Text
  reviewed         Boolean          @default(false)
  reviewedBy       String?
  firstAidVersion  Int              @default(1)
  species          DiseaseSpecies[]
  symptoms         DiseaseSymptom[]
}

model DiseaseSpecies {
  diseaseId Int
  speciesId Int
  disease   Disease @relation(fields: [diseaseId], references: [id])
  species   Species @relation(fields: [speciesId], references: [id])

  @@id([diseaseId, speciesId])
}

model DiseaseSymptom {
  diseaseId Int
  symptomId Int
  weight    Int     @default(1)
  disease   Disease @relation(fields: [diseaseId], references: [id])
  symptom   Symptom @relation(fields: [symptomId], references: [id])

  @@id([diseaseId, symptomId])
}

model Vet {
  id        Int          @id @default(autoincrement())
  name      String
  type      VetType
  verified  Boolean      @default(false)
  phone     String?
  county    String?
  latitude  Decimal      @db.Decimal(9, 6)
  longitude Decimal      @db.Decimal(9, 6)
  species   VetSpecies[]
}

model VetSpecies {
  vetId     Int
  speciesId Int
  vet       Vet     @relation(fields: [vetId], references: [id])
  species   Species @relation(fields: [speciesId], references: [id])

  @@id([vetId, speciesId])
}

model VetUser {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  confirmed    SymptomTerm[]
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(FARMER)
  phone        String?
  county       String?
  farmSize     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Report {
  id              Int             @id @default(autoincrement())
  speciesId       Int
  county          String?
  latitude        Decimal?        @db.Decimal(9, 6)
  longitude       Decimal?        @db.Decimal(9, 6)
  animalsAffected Int             @default(1)
  animalsDead     Int             @default(0)
  isHerd          Boolean         @default(false)
  herdSize        Int?
  isSimulated     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  species         Species         @relation(fields: [speciesId], references: [id])
  symptoms        ReportSymptom[]

  @@index([createdAt])
}

model ReportSymptom {
  reportId  Int
  symptomId Int
  report    Report  @relation(fields: [reportId], references: [id])
  symptom   Symptom @relation(fields: [symptomId], references: [id])

  @@id([reportId, symptomId])
}

model Feed {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  category        String
  dryMatterPct    Decimal  @db.Decimal(5, 2)
  crudeProteinPct Decimal  @db.Decimal(5, 2)
  energyMjPerKg   Decimal  @db.Decimal(5, 2)
  calciumPct      Decimal  @db.Decimal(5, 3)
  phosphorusPct   Decimal  @db.Decimal(5, 3)
  pricePerKg      Decimal? @db.Decimal(8, 2)
}

model NutrientRequirement {
  id            Int     @id @default(autoincrement())
  speciesId     Int
  stage         String
  proteinPct    Decimal @db.Decimal(5, 2)
  energyMjPerKg Decimal @db.Decimal(5, 2)
  calciumPct    Decimal @db.Decimal(5, 3)
  phosphorusPct Decimal @db.Decimal(5, 3)
  species       Species @relation(fields: [speciesId], references: [id])

  @@unique([speciesId, stage])
}

// ==========================================
// AI STRAW VERIFICATION & GENETICS SUBSYSTEM
// ==========================================

enum ProductType {
  SEXED_FEMALE
  SEXED_MALE
  CONVENTIONAL
  BEEF
  UNKNOWN
}

enum Confidence {
  HIGH
  MEDIUM
  NONE
}

enum ProviderType {
  SUPPLIER
  DISTRIBUTOR
  TECHNICIAN
}

enum EventStatus {
  DRAFT
  SENT
  CONFIRMED
  NOT_RECOGNISED
  NO_REPLY
}

enum RuleField {
  BREED
  SUPPLIER
  SEXED_MARKER
  BATCH
  SERIAL
  BULL
}

enum PregnancyResult {
  PREGNANT
  NOT_PREGNANT
  UNKNOWN
}

enum CalfSex {
  FEMALE
  MALE
  UNKNOWN
}

enum FlagType {
  HIGH_QUERY_COUNT
  SEX_RATIO
  PRICE_HIGH
  PROVIDER_COMPLAINT
  NOT_RECOGNISED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

model Breed {
  id     Int                 @id @default(autoincrement())
  code   String              @unique @db.VarChar(10)
  name   String
  bulls  Bull[]
  cows   Cow[]
  events InseminationEvent[]
}

model Supplier {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  country   String?
  prefixes  SupplierPrefix[]
  rules     LabelRule[]
  bulls     Bull[]
  batches   Batch[]
  providers Provider[]
  events    InseminationEvent[]
}

model SupplierPrefix {
  id         Int      @id @default(autoincrement())
  prefix     String   @unique @db.VarChar(20)
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
}

model LabelRule {
  id          Int          @id @default(autoincrement())
  supplierId  Int?
  field       RuleField
  pattern     String       @db.VarChar(255)
  meaning     String
  productType ProductType?
  notes       String?      @db.Text
  isActive    Boolean      @default(true)
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
}

model Bull {
  id             Int                 @id @default(autoincrement())
  name           String
  registrationId String?
  breedId        Int?
  supplierId     Int?
  breed          Breed?              @relation(fields: [breedId], references: [id])
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  batches        Batch[]
  events         InseminationEvent[]

  @@index([name])
}

model Batch {
  id             Int                 @id @default(autoincrement())
  supplierId     Int
  batchCode      String              @db.VarChar(50)
  bullId         Int?
  productType    ProductType         @default(UNKNOWN)
  productionDate DateTime?
  blacklisted    Boolean             @default(false)
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  bull           Bull?               @relation(fields: [bullId], references: [id])
  events         InseminationEvent[]
  flags          FraudFlag[]

  @@unique([supplierId, batchCode])
}

model Provider {
  id             Int                 @id @default(autoincrement())
  name           String
  type           ProviderType
  whatsappNumber String?             @db.VarChar(20)
  county         String?
  registered     Boolean             @default(false)
  supplierId     Int?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  verifiedEvents InseminationEvent[] @relation("EventProvider")
  doneEvents     InseminationEvent[] @relation("EventTechnician")
  flags          FraudFlag[]
}

model Farmer {
  id            Int                 @id @default(autoincrement())
  name          String?
  phone         String              @unique @db.VarChar(20)
  county        String?
  pinHash       String?             @db.VarChar(255)
  phoneVerified Boolean             @default(false)
  lastLoginAt   DateTime?
  role          UserRole            @default(FARMER)
  createdAt     DateTime            @default(now())
  cows          Cow[]
  events        InseminationEvent[]
  queries       StrawQuery[]
}

model Cow {
  id       Int                 @id @default(autoincrement())
  farmerId Int
  name     String
  tagNo    String?
  breedId  Int?
  farmer   Farmer              @relation(fields: [farmerId], references: [id])
  breed    Breed?              @relation(fields: [breedId], references: [id])
  events   InseminationEvent[]
}

model StrawQuery {
  id        Int      @id @default(autoincrement())
  farmerId  Int?
  rawText   String   @db.Text
  codeKey   String   @db.VarChar(100)
  county    String?
  createdAt DateTime @default(now())
  farmer    Farmer?  @relation(fields: [farmerId], references: [id])

  @@index([codeKey, createdAt])
}

model InseminationEvent {
  id           Int         @id @default(autoincrement())
  referenceNo  String      @unique @db.VarChar(20)
  farmerId     Int
  cowId        Int?
  rawText      String      @db.Text
  decoded      Json
  confidence   Confidence  @default(NONE)
  breedId      Int?
  supplierId   Int?
  bullId       Int?
  batchId      Int?
  productType  ProductType @default(UNKNOWN)
  technicianId Int?
  providerId   Int?
  priceKsh     Decimal?    @db.Decimal(10, 2)
  eventDate    DateTime
  county       String?
  latitude     Decimal?    @db.Decimal(9, 6)
  longitude    Decimal?    @db.Decimal(9, 6)
  status       EventStatus @default(DRAFT)
  sentAt       DateTime?
  respondedAt  DateTime?
  photoUrls    Json?
  createdAt    DateTime    @default(now())
  farmer       Farmer      @relation(fields: [farmerId], references: [id])
  cow          Cow?        @relation(fields: [cowId], references: [id])
  breed        Breed?      @relation(fields: [breedId], references: [id])
  supplier     Supplier?   @relation(fields: [supplierId], references: [id])
  bull         Bull?       @relation(fields: [bullId], references: [id])
  batch        Batch?      @relation(fields: [batchId], references: [id])
  technician   Provider?   @relation("EventTechnician", fields: [technicianId], references: [id])
  provider     Provider?   @relation("EventProvider", fields: [providerId], references: [id])
  outcome      Outcome?
  flags        FraudFlag[]

  @@index([status])
  @@index([technicianId])
  @@index([batchId])
}

model Outcome {
  id        Int               @id @default(autoincrement())
  eventId   Int               @unique
  pregnancy PregnancyResult   @default(UNKNOWN)
  checkedAt DateTime?
  calfSex   CalfSex?
  birthDate DateTime?
  event     InseminationEvent @relation(fields: [eventId], references: [id])
}

model FraudFlag {
  id         Int                @id @default(autoincrement())
  type       FlagType
  severity   Severity           @default(MEDIUM)
  details    String             @db.Text
  eventId    Int?
  providerId Int?
  batchId    Int?
  resolved   Boolean            @default(false)
  createdAt  DateTime           @default(now())
  event      InseminationEvent? @relation(fields: [eventId], references: [id])
  provider   Provider?          @relation(fields: [providerId], references: [id])
  batch      Batch?             @relation(fields: [batchId], references: [id])
}

model PriceBenchmark {
  id          Int         @id @default(autoincrement())
  productType ProductType
  minKsh      Decimal     @db.Decimal(10, 2)
  maxKsh      Decimal     @db.Decimal(10, 2)
  county      String?
  source      String
  asOf        DateTime
}
